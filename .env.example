# --- LLM provider -----------------------------------------------------------
# "anthropic" (default) or "zai" (Zhipu GLM via its Anthropic-compatible endpoint).
LLM_PROVIDER=anthropic

# Anthropic (LLM_PROVIDER=anthropic): set this, leave the z.ai vars blank.
ANTHROPIC_API_KEY=

# z.ai / GLM (LLM_PROVIDER=zai): set these instead of ANTHROPIC_API_KEY.
#   LLM_PROVIDER=zai
#   ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
#   ANTHROPIC_AUTH_TOKEN=your_zai_api_key
#   AGENT_MODEL=glm-4.6            # or glm-4.7 / glm-5.2, per your plan
#   NORMALISER_MODEL=glm-4.5-air
# NOTE: GLM cannot run Anthropic's native web_search. For live web search on z.ai,
# set WEB_SEARCH_PROVIDER=tavily and add a TAVILY_API_KEY below; otherwise the agent
# runs without web search (KB, parcels, geocode, site-risk, compare still work).
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
AGENT_MODEL=
NORMALISER_MODEL=

# --- Postgres + pgvector (matches docker-compose.yml) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/risk

# --- Embedding service (Python FastAPI) ---
EMBED_SERVICE_URL=http://localhost:8000

# --- Web search backend ---
# "anthropic" => native web_search_20260209 server tool (default, no extra key)
# "tavily"    => custom Tavily-backed tool (requires TAVILY_API_KEY)
WEB_SEARCH_PROVIDER=anthropic
TAVILY_API_KEY=

# --- Parcel data (ArcGIS FeatureServers need NO key) ---
# Optional: only when a county is served via a Socrata portal (e.g. data.sccgov.org).
# A token raises SODA API rate limits; queries still work without it.
SOCRATA_APP_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
